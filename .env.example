# ============================================================================
#  Farfasha Play Center — environment configuration
#  Copy this file to `.env` (in the project root) and adjust values.
#  docker-compose reads this file; local dev also reads it (backend + Vite).
# ============================================================================

# ---- Runtime -----------------------------------------------------------------
NODE_ENV=development
# All server-side time math / display uses this zone. Do not change casually.
TZ=Asia/Riyadh
# Public URL where the app is reached (used to build QR / customer-card links)
APP_BASE_URL=http://localhost:5173
# Port the Express API + Socket.IO server listen on
API_PORT=4000
# Comma-separated origins allowed by CORS (frontend dev + prod)
FRONTEND_URL=http://localhost:5173

# ---- PostgreSQL --------------------------------------------------------------
# Either provide a full DATABASE_URL, or the individual PG* parts below.
# When running via docker-compose, host is the service name `postgres`.
DATABASE_URL=postgres://farfasha:farfasha@localhost:5432/farfasha
PGHOST=localhost
PG_BIND_IP=127.0.0.1
PGPORT=5432
PGUSER=farfasha
PGPASSWORD=farfasha
PGDATABASE=farfasha

# ---- Redis (BullMQ queue + Socket.IO scaling) --------------------------------
# When running via docker-compose, host is the service name `redis`.
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Auth --------------------------------------------------------------------
# CHANGE THIS in production to a long random string.
JWT_SECRET=change-me-in-production-please-use-a-long-random-secret
JWT_EXPIRES_IN=12h

# ---- Tenant ------------------------------------------------------------------
# The system is schema-tenant-ready; this single tenant is seeded by default.
DEFAULT_TENANT_SLUG=farfasha

# ---- Seed credentials (created by `npm run seed`) ----------------------------
SEED_MANAGER_NAME=مدير المركز
SEED_MANAGER_EMAIL=manager@farfasha.sa
SEED_MANAGER_PASSWORD=manager123
SEED_STAFF_NAME=موظف الاستقبال
SEED_STAFF_EMAIL=staff@farfasha.sa
SEED_STAFF_PASSWORD=staff123

# ---- WhatsApp ----------------------------------------------------------------
# Master switch. When false, messages are LOGGED (never sent) regardless of provider.
# This lets the whole system run end-to-end before the WhatsApp Business account is ready.
WHATSAPP_ENABLED=false
# Adapter: log | meta | twilio | unifonic
WHATSAPP_PROVIDER=log
# The E.164 default country code used to normalise Saudi mobile numbers (05x -> 9665x).
WHATSAPP_DEFAULT_COUNTRY=966

# --- Meta WhatsApp Cloud API (used when WHATSAPP_PROVIDER=meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Names of your APPROVED Meta message templates (per type).
WHATSAPP_TEMPLATE_WELCOME=farfasha_welcome
WHATSAPP_TEMPLATE_WARN5=farfasha_warn5
WHATSAPP_TEMPLATE_TIMEUP=farfasha_timeup
# Post-visit "how was your visit?" ask. Carries the review link.
WHATSAPP_TEMPLATE_REVIEW=farfasha_review

# --- Twilio (used when WHATSAPP_PROVIDER=twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Unifonic (Saudi BSP; used when WHATSAPP_PROVIDER=unifonic) ---
UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=

# ---- Payments (future-ready placeholder — NOT wired to a live gateway) -------
# Party/workshop bookings are reserve-now / pay-at-the-centre: the slot is held
# and the price frozen on booking, and staff settle payment in the Bookings
# page. Wiring a gateway means one adapter in src/payments/ — the booking
# domain does not change.
PAYMENTS_ENABLED=false
# provider: moyasar | hyperpay | geidea
PAYMENTS_PROVIDER=moyasar

# ---- Frontend (Vite) — must be prefixed VITE_ --------------------------------
VITE_API_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000
VITE_PUBLIC_BASE_URL=http://localhost:5173
